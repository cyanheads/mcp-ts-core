{
  "depcheck": {
    "ignores": [
      "@types/*",
      "pino-pretty",
      "typescript",
      "@vitest/coverage-istanbul",
      "repomix",
      "bun",
      "depcheck",
      "tsc-alias",
      "@cyanheads/mcp-ts-core",
      "@socketsecurity/bun-security-scanner",
      "typedoc",
      "cloudflare:*"
