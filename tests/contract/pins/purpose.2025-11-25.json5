    "tools/list": {
      "result": {
        "tools": [
          {
            "annotations": {
              "openWorldHint": false,
              "readOnlyHint": true
            },
            "description": "Searches an index with every kind of argument a client can send.",
            "inputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "description": "Opaque upstream code.",
                  "type": "string"
                },
                "filter": {
                  "description": "One field filter.",
                  "properties": {
                    "field": {
                      "description": "Field name.",
                      "type": "string"
                    },
                    "op": {
                      "description": "Comparison operator.",
                      "enum": [
                        "eq",
                        "ne"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "op"
                  ],
                  "type": "object"
                },
                "limit": {
                  "default": 10,
                  "description": "Maximum results.",
                  "maximum": 50,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxResults": {
                  "description": "Upstream result cap.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "note": {
                  "description": "Free-text note.",
                  "type": "string"
                },
                "query": {
                  "description": "Search query.",
                  "minLength": 1,
                  "type": "string"
                },
                "region": {
                  "anyOf": [
                    {
                      "const": "",
                      "type": "string"
                    },
                    {
                      "enum": [
                        "us",
                        "eu"
                      ],
                      "type": "string"
                    }
                  ],
                  "description": "Region, or blank for any."
                },
                "routing": {
                  "description": "Routing hints.",
                  "properties": {
                    "tenant": {
                      "description": "Tenant to route to.",
                      "type": "string",
                      "x-mcp-header": "Tenant"
                    }
                  },
                  "required": [
                    "tenant"
                  ],
                  "type": "object"
                },
                "shape": {
                  "description": "Search area.",
                  "oneOf": [
                    {
                      "properties": {
                        "kind": {
                          "const": "circle",
                          "description": "A circle.",
                          "type": "string"
                        },
                        "radius": {
                          "description": "Radius.",
                          "type": "number"
                        }
                      },
                      "required": [
                        "kind",
                        "radius"
                      ],
                      "type": "object"
                    },
                    {
                      "properties": {
                        "kind": {
                          "const": "square",
                          "description": "A square.",
                          "type": "string"
                        },
                        "side": {
                          "description": "Side length.",
                          "type": "number"
                        }
                      },
                      "required": [
                        "kind",
                        "side"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "tags": {
                  "description": "Tags to include.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "weights": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "description": "Per-field ranking weights.",
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "required": [
                "query"
              ],
              "type": "object"
            },
            "name": "contract_probe",
            "outputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "anyOf": [
                {
                  "not": {
                    "required": [
                      "error"
                    ]
                  },
                  "required": [
                    "ok"
                  ]
                },
                {
                  "required": [
                    "error"
                  ]
                }
              ],
              "properties": {
                "error": {
                  "additionalProperties": {},
                  "description": "Present when the call failed. Absent on success.",
                  "properties": {
                    "code": {
                      "description": "JSON-RPC error code for this failure.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "data": {
                      "additionalProperties": {},
                      "properties": {
                        "reason": {
                          "description": "Machine-readable failure mode. Declared by this tool: `index_missing`: The search index has not been built. `queue_full`: The search queue is at capacity. Other values are possible when a failure originates below the handler.",
                          "examples": [
                            "index_missing",
                            "queue_full"
                          ],
                          "type": "string"
                        },
                        "recovery": {
                          "additionalProperties": {},
                          "description": "Actionable next step for the caller.",
                          "properties": {
                            "hint": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "hint"
                          ],
                          "type": "object"
                        },
                        "retryable": {
                          "description": "Whether retrying may succeed.",
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    },
                    "message": {
                      "description": "Human-readable description of what went wrong.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": "object"
                },
                "ok": {
                  "description": "Always true.",
                  "type": "boolean"
                },
                "total": {
                  "description": "Total matches.",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "title": "Contract Probe"
          },
          {
            "description": "Looks a record up by exactly one key.",
            "inputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "description": "Record ID.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "mode": {
                      "const": "byId",
                      "description": "Look up by ID.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode",
                    "id"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fuzzy": {
                      "default": false,
                      "description": "Match loosely.",
                      "type": "boolean"
                    },
                    "mode": {
                      "const": "byName",
                      "description": "Search by name.",
                      "type": "string"
                    },
                    "name": {
                      "description": "Name fragment.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "mode",
                    "name"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            "name": "contract_union_root",
            "outputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
